const SEMESTER_START = new Date('2026-08-17');
const SEMESTER_END = new Date('2026-11-27');
const TODAY = new Date('2026-09-28'); // Sync with context

const weeksTotal = Math.max(0, Math.floor((SEMESTER_END - SEMESTER_START) / (1000*60*60*24*7)));
const weeksPassed = Math.max(0, Math.floor((TODAY - SEMESTER_START) / (1000*60*60*24*7)));
const weeksRemainingInSem = Math.max(0, weeksTotal - weeksPassed);

function loadCohortInputs() {
    const section = document.getElementById('cohortSelect').value;
    const container = document.getElementById('subjectInputs');
    container.innerHTML = '';
    
    if(!section) { container.innerHTML = '<p style="color:var(--text-muted); font-size: 0.9rem;">Select a cohort to enter attendance %.</p>'; return; }
    
    SECTION_DATA[section].forEach((subj, idx) => {
        container.innerHTML += `
            <div class="subj-row">
                <span title="${subj.name}">${subj.name}</span>
                <div style="display:flex; align-items:center; gap:5px;">
                    <input type="number" id="att_${idx}" placeholder="0" min="0" max="100"> 
                    <strong style="font-size:0.8rem; color:#6b7280;">%</strong>
                </div>
            </div>
        `;
    });
}

function executeAnalysis() {
    const section = document.getElementById('cohortSelect').value;
    if(!section) { alert("Please select a cohort first."); return; }
    
    const leaveDays = parseInt(document.getElementById('leaveDays').value) || 0;
    const leaveType = document.getElementById('leaveType').value;
    
    let totalHappened = 0; let totalAttended = 0;
    const resultsGrid = document.getElementById('resultsGrid');
    resultsGrid.innerHTML = '';
    
    SECTION_DATA[section].forEach((subj, idx) => {
        let basePercent = parseFloat(document.getElementById(`att_${idx}`).value) || 0;
        if(basePercent > 100) basePercent = 100; if(basePercent < 0) basePercent = 0;
        
        const classesHappened = subj.weekly * weeksPassed;
        const attendedSoFar = Math.round((basePercent / 100) * classesHappened);
        const totalClassesInSem = subj.weekly * weeksTotal;
        
        const simulatedAffected = Math.ceil(leaveDays * (subj.weekly / 5));
        let finalAttended = attendedSoFar; let finalHappened = classesHappened;
        
        if (leaveDays > 0) {
            if (leaveType === 'od') { finalAttended += simulatedAffected; finalHappened += simulatedAffected; } 
            else { finalHappened += simulatedAffected; }
        }
        
        const currentPercent = finalHappened === 0 ? 0 : ((finalAttended / finalHappened) * 100);
        const classesRemaining = (subj.weekly * weeksRemainingInSem) - simulatedAffected;
        const requiredFor75 = Math.ceil(0.75 * totalClassesInSem);
        const neededToReach75 = requiredFor75 - finalAttended;
        const isDetention = neededToReach75 > Math.max(0, classesRemaining);
        
        totalHappened += classesHappened;
        totalAttended += attendedSoFar;
        
        let colorClass = currentPercent >= 75 ? 'var(--free-color)' : (isDetention ? 'var(--occupied-color)' : 'var(--warning-color)');
        
        resultsGrid.innerHTML += `
            <div class="subj-result-card ${isDetention ? 'detention' : ''}">
                ${isDetention ? '<div style="color:var(--occupied-color); font-weight:800; font-size:1rem; text-align:center; text-transform:uppercase; margin-bottom:5px;"><i class="fa-solid fa-triangle-exclamation"></i> Detention Risk</div>' : ''}
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                    <strong style="font-size:0.8rem; width:75%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${subj.name}">${subj.name}</strong>
                    <span style="font-weight:800; color:${colorClass};">${currentPercent.toFixed(1)}%</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-fill" style="width:${Math.min(currentPercent, 100)}%; background:${colorClass};"></div>
                </div>
                <div class="stats-grid">
                    <div class="stat-box">
                        <div style="font-size:0.65rem; color:var(--text-muted); text-transform:uppercase;">Need (75%)</div>
                        <div style="font-weight:700;">${Math.max(0, neededToReach75)}</div>
                    </div>
                    <div class="stat-box ${isDetention ? 'detention-box' : ''}">
                        <div style="font-size:0.65rem; color:var(--text-muted); text-transform:uppercase;">Buffer Left</div>
                        <div style="font-weight:700;">${Math.max(0, classesRemaining - Math.max(0, neededToReach75))}</div>
                    </div>
                </div>
                ${leaveDays > 0 ? `<div style="font-size:0.75rem; text-align:center; margin-top:8px; color:var(--primary); font-weight:600;">Simulated: ${leaveType==='od'?'+':'-'}${simulatedAffected} classes</div>` : ''}
            </div>
        `;
    });
    
    const health = totalHappened === 0 ? 0 : ((totalAttended / totalHappened) * 100);
    const hCircle = document.getElementById('healthCircle');
    hCircle.innerText = health.toFixed(1) + '%';
    hCircle.style.background = `conic-gradient(${health >= 75 ? 'var(--free-color)' : 'var(--occupied-color)'} ${health}%, #e5e7eb ${health}%)`;
    hCircle.style.color = health >= 75 ? 'white' : 'white';
}

// --- CHATBOT ---
function toggleChat() {
    const w = document.getElementById('chatWindow');
    w.style.display = w.style.display === 'flex' ? 'none' : 'flex';
}

function sendChatMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim(); if(!text) return;
    const body = document.getElementById('chatBody');
    
    body.innerHTML += `<div class="chat-msg msg-user">${text}</div>`;
    input.value = ''; body.scrollTop = body.scrollHeight;
    
    setTimeout(() => {
        const section = document.getElementById('cohortSelect').value;
        let reply = "";
        
        if(!section) {
            reply = "Please initialize a cohort and execute the analysis on the dashboard first.";
        } else {
            const daysMatch = text.match(/(\d+)\s*-?\s*day/i);
            const days = daysMatch ? parseInt(daysMatch[1]) : 0;
            let matchedSubject = null;
            
            SECTION_DATA[section].forEach(s => {
                // simple heuristic for subject match
                if(text.toLowerCase().includes(s.name.toLowerCase().split(' ')[0])) {
                    matchedSubject = s;
                    matchedSubject.idx = SECTION_DATA[section].indexOf(s); 
                }
            });
            
            const isOD = text.toLowerCase().includes('od') || text.toLowerCase().includes('duty');
            
            if(days > 0 && matchedSubject) {
                const classesAffected = Math.ceil(days * (matchedSubject.weekly / 5));
                const happened = matchedSubject.weekly * weeksPassed;
                const baseVal = parseFloat(document.getElementById(`att_${matchedSubject.idx}`).value) || 0;
                const currentlyAttended = Math.round((baseVal / 100) * happened);
                
                if(isOD) {
                    const proj = ((currentlyAttended + classesAffected) / (happened + classesAffected)) * 100;
                    reply = `Processing ${days}-day OD. You will gain approx ${classesAffected} classes for ${matchedSubject.name}. Attendance shifts to ${proj.toFixed(1)}%.`;
                } else {
                    const proj = ((currentlyAttended) / (happened + classesAffected)) * 100;
                    reply = `Analyzing ${days}-day leave. You miss approx ${classesAffected} classes of ${matchedSubject.name}. Attendance drops to ${proj.toFixed(1)}%. `;
                    reply += proj < 75 ? "⚠️ Drops below 75% threshold." : "✅ Clearance granted (>75%).";
                }
            } else if(days > 0 && !matchedSubject) {
                reply = `I detected a ${days}-day leave request, but couldn't identify the subject. Try typing the exact subject name.`;
            } else {
                reply = "Query not recognized. Try: 'If I take a 2-day leave, how does it affect Chemistry?'";
            }
        }
        
        body.innerHTML += `<div class="chat-msg msg-bot">${reply}</div>`;
        body.scrollTop = body.scrollHeight;
    }, 600);
}
