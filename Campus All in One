function closeModal() { document.getElementById('roomModal').style.display = 'none'; clearInterval(timerInterval); }
function updateCountdown() {
    if(!activeRoom) return;
    let diff = roomExpiryDate - new Date();
    if(diff <= 0) { document.getElementById('countdownTimer').innerText = "00:00"; document.getElementById('timerStatus').innerText = "Class started!"; return; }
    document.getElementById('countdownTimer').innerText = `${Math.floor(diff/60000).toString().padStart(2,'0')}:${Math.floor((diff%60000)/1000).toString().padStart(2,'0')}`;
    document.getElementById('timerStatus').innerText = `Free until ${roomExpiryDate.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}`;
}
function callTheSquad() {
    let phone = document.getElementById('whatsappPhone').value.trim().replace(/\D/g,'');
    let time = roomExpiryDate.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
    let msg = encodeURIComponent(`📍 Heading to ${activeRoom.id}. Free until ${time}. Come fast!`);
    window.open(phone ? `https://wa.me/${phone}?text=${msg}` : `https://api.whatsapp.com/send?text=${msg}`, '_blank');
}

