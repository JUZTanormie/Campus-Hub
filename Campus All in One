<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus All-In-One Hub</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(255, 255, 255, 0.5);
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --free-color: #10b981;
            --occupied-color: #ef4444;
            --warning-color: #f59e0b;
            --lab-color: #8b5cf6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }

        body {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            min-height: 100vh;
            color: var(--text-main);
            overflow-x: hidden;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container { max-width: 1300px; margin: 2rem auto; padding: 0 1rem; position: relative; z-index: 10; }

        /* ---------- HEADER & TABS ---------- */
        header {
            background: var(--glass-bg); backdrop-filter: blur(12px); border: 1px solid var(--glass-border);
            border-radius: 20px; padding: 1.5rem 2rem; display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 2rem; box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15); flex-wrap: wrap; gap: 1rem;
        }

        header h1 {
            font-size: 1.8rem; font-weight: 800;
            background: linear-gradient(to right, #4f46e5, #ec4899);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .tabs { display: flex; gap: 0.8rem; flex-wrap: wrap; }
        .tab-btn {
            background: rgba(255, 255, 255, 0.6); border: 1px solid var(--glass-border); padding: 0.75rem 1.2rem;
            border-radius: 12px; cursor: pointer; font-weight: 600; transition: all 0.3s ease; color: var(--text-main);
            display: flex; align-items: center; gap: 8px;
        }
        .tab-btn.active { background: var(--primary); color: white; box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4); border-color: var(--primary); }

        .panel {
            display: none; background: var(--glass-bg); backdrop-filter: blur(12px); border: 1px solid var(--glass-border);
            border-radius: 20px; padding: 2.5rem; box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15); min-height: 650px;
        }
        .panel.active { display: block; animation: fadeIn 0.4s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* ---------- 3D MAP ---------- */
        .map-controls { display: flex; justify-content: center; gap: 1rem; margin-bottom: 2rem; }
        .scene3d { perspective: 1200px; width: 100%; height: 480px; display: flex; justify-content: center; align-items: center; margin-top: -20px; }
        .floor-plan {
            position: relative; width: 650px; height: 450px; transform: rotateX(60deg) rotateZ(-45deg);
            transform-style: preserve-3d; background: rgba(255, 255, 255, 0.3); border: 2px dashed rgba(255, 255, 255, 0.6); border-radius: 15px;
        }
        .room3d {
            position: absolute; width: 55px; height: 55px; background: white; border: 1px solid #ddd;
            display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 0.75rem;
            cursor: pointer; transform-style: preserve-3d; transition: 0.3s; box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .room3d::before { content: ''; position: absolute; width: 100%; height: 25px; background: inherit; filter: brightness(0.7); bottom: -25px; left: 0; transform-origin: top; transform: rotateX(-90deg); }
        .room3d::after { content: ''; position: absolute; width: 25px; height: 100%; background: inherit; filter: brightness(0.85); top: 0; right: -25px; transform-origin: left; transform: rotateY(90deg); }
        .room3d:hover { transform: translateZ(25px); box-shadow: 0 15px 30px rgba(0,0,0,0.3); }
        .room3d.free { background: var(--free-color); color: white; border-color: #047857; }
        .room3d.occupied { background: var(--occupied-color); color: white; border-color: #b91c1c; opacity: 0.7; cursor: not-allowed; }
        .room3d.lab { border: 3px solid var(--lab-color); color: var(--lab-color); }
        .room3d.lab.free { color: white; border-color: #4c1d95; }
        .legend { text-align: center; margin-top: 1rem; background: rgba(255,255,255,0.8); display: inline-block; padding: 10px 20px; border-radius: 20px; font-weight: 500; }

        /* ---------- AI FINDER ---------- */
        .search-container { display: flex; flex-direction: column; gap: 1.5rem; max-width: 800px; margin: 0 auto; }
        .search-bar-wrapper { position: relative; width: 100%; }
        .search-input { width: 100%; padding: 1.2rem 1.5rem; padding-right: 4.5rem; font-size: 1.1rem; border: 2px solid transparent; border-radius: 16px; background: white; outline: none; transition: 0.3s; }
        .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); }
        .search-btn { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: var(--primary); color: white; border: none; width: 45px; height: 45px; border-radius: 12px; cursor: pointer; font-size: 1.2rem; }
        .results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
        .room-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-top: 5px solid var(--free-color); }
        .badge { padding: 0.25rem 0.6rem; border-radius: 8px; font-size: 0.75rem; font-weight: 600; margin-left: 5px; }
        .badge.free { background: #d1fae5; color: #065f46; } .badge.ac { background: #dbeafe; color: #1e40af; } .badge.lab { background: #ede9fe; color: #5b21b6; }

        /* ---------- ATTENDANCE MATRIX ---------- */
        .matrix-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
        @media (min-width: 1024px) { .matrix-grid { grid-template-columns: 1fr 2fr; } }
        .input-card, .results-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .input-group label { display: block; font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; margin-bottom: 0.5rem; }
        .styled-input, .styled-select { width: 100%; padding: 0.8rem; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; outline: none; transition: 0.3s; margin-bottom: 1rem;}
        .styled-input:focus, .styled-select:focus { border-color: var(--primary); }
        .subj-row { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem; background: #f9fafb; border-radius: 10px; margin-bottom: 0.5rem; border: 1px solid #f3f4f6; }
        .subj-row span { font-weight: 500; font-size: 0.9rem; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .subj-row input { width: 70px; padding: 0.4rem; border: 1px solid #d1d5db; border-radius: 6px; text-align: right; outline:none;}
        .subj-row input:focus{ border-color: var(--primary); }
        .btn-execute { width: 100%; background: var(--primary); color: white; padding: 1rem; border: none; border-radius: 10px; font-weight: 600; font-size: 1.1rem; cursor: pointer; margin-top: 1rem; transition: 0.3s; }
        .btn-execute:hover { background: var(--primary-hover); }
        .health-banner { display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 1.5rem; border-radius: 16px; border: 2px solid #e2e8f0; margin-bottom: 1.5rem; }
        .health-circle { width: 80px; height: 80px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.5rem; font-weight: 800; }
        .result-items { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
        .subj-result-card { padding: 1rem; border-radius: 12px; background: #fff; border: 1px solid #e5e7eb; position: relative; overflow: hidden; }
        .subj-result-card.detention { background: #fef2f2; border-color: #fca5a5; }
        .progress-bar-bg { width: 100%; height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden; margin: 0.5rem 0; }
        .progress-fill { height: 100%; transition: width 0.5s ease; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem; }
        .stat-box { background: #f3f4f6; padding: 0.5rem; border-radius: 8px; text-align: center; }
        .stat-box.detention-box { background: #fee2e2; }

        /* ---------- CHATBOT ---------- */
        .chat-btn {
            position: fixed; bottom: 2rem; right: 2rem; width: 60px; height: 60px; background: var(--primary); color: white; border-radius: 50%; display: flex;
            justify-content: center; align-items: center; font-size: 1.5rem; cursor: pointer; box-shadow: 0 10px 25px rgba(79,70,229,0.4); z-index: 100; border: none; transition: 0.3s;
        }
        .chat-btn:hover { transform: scale(1.1); }
        .chat-window {
            position: fixed; bottom: 6rem; right: 2rem; width: 350px; height: 500px; background: white; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.2);
            display: none; flex-direction: column; z-index: 100; overflow: hidden; border: 1px solid #e5e7eb;
        }
        .chat-header { background: var(--primary); color: white; padding: 1rem; font-weight: 600; display: flex; align-items: center; gap: 10px; }
        .chat-body { flex: 1; padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; background: #f9fafb; }
        .chat-msg { max-width: 85%; padding: 0.8rem 1rem; border-radius: 15px; font-size: 0.9rem; }
        .msg-bot { background: white; border: 1px solid #e5e7eb; align-self: flex-start; border-bottom-left-radius: 0; }
        .msg-user { background: var(--primary); color: white; align-self: flex-end; border-bottom-right-radius: 0; }
        .chat-input-area { padding: 1rem; background: white; border-top: 1px solid #e5e7eb; display: flex; gap: 0.5rem; align-items: center;}

        /* ---------- MODAL ---------- */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal { background: white; padding: 2.5rem; border-radius: 20px; width: 90%; max-width: 380px; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.2); position: relative; }
        .close-modal { position: absolute; top: 15px; right: 20px; font-size: 1.5rem; cursor: pointer; color: #888; }
        .timer-circle { width: 130px; height: 130px; border-radius: 50%; border: 6px solid var(--free-color); display: flex; flex-direction: column; justify-content: center; align-items: center; margin: 0 auto 1.5rem; background: #f0fdf4; }
        .timer-val { font-size: 2rem; font-weight: 700; color: var(--free-color); line-height: 1; }
        .squad-btn { background: #25D366; color: white; border: none; padding: 1rem; border-radius: 12px; font-size: 1rem; font-weight: 600; cursor: pointer; width: 100%; display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 1rem; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1><i class="fa-solid fa-graduation-cap"></i> Campus Hub</h1>
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('map-view', this)"><i class="fa-solid fa-map-location-dot"></i> 3D Map</button>
            <button class="tab-btn" onclick="switchTab('ai-finder', this)"><i class="fa-solid fa-robot"></i> AI Finder</button>
            <button class="tab-btn" onclick="switchTab('attendance-matrix', this)"><i class="fa-solid fa-chart-pie"></i> Core Calculator</button>
        </div>
    </header>

    <!-- MODULE 1: 3D MAP -->
    <section id="map-view" class="panel active">
        <div class="map-controls">
            <select id="floorSelect" class="styled-select" style="width:auto; font-weight:600; margin-bottom:0;" onchange="render3DMap()">
                <option value="1">1st Floor</option>
                <option value="2">2nd Floor</option>
                <option value="3" selected>3rd Floor (Labs Included)</option>
                <option value="4">4th Floor</option>
                <option value="5">5th Floor</option>
                <option value="6">6th Floor (Labs Included)</option>
                <option value="7">7th Floor</option>
            </select>
        </div>
        <div class="scene3d"><div class="floor-plan" id="floorPlanArea"></div></div>
        <div style="text-align: center;">
            <div class="legend">
                <i class="fa-solid fa-square" style="color: var(--free-color);"></i> Free 
                <i class="fa-solid fa-square" style="color: var(--occupied-color); margin-left: 15px;"></i> Occupied
                <i class="fa-solid fa-square" style="color: white; border: 2px solid var(--lab-color); margin-left: 15px; border-radius:3px;"></i> Lab
            </div>
        </div>
    </section>

    <!-- MODULE 2: AI FINDER -->
    <section id="ai-finder" class="panel">
        <div class="search-container">
            <h2 style="text-align: center;"><i class="fa-solid fa-wand-magic-sparkles"></i> NLP Room Assistant</h2>
            <p style="text-align: center; color: var(--text-muted);">Example: "I need an AC room on the 5th floor"</p>
            <div class="search-bar-wrapper">
                <input type="text" id="aiInput" class="search-input" placeholder="What kind of room do you need right now?" onkeypress="if(event.key === 'Enter') processAIQuery()">
                <button class="search-btn" onclick="processAIQuery()"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
            <div id="aiResults" class="results-grid"></div>
        </div>
    </section>

    <!-- MODULE 3: ATTENDANCE MATRIX -->
    <section id="attendance-matrix" class="panel">
        <div class="matrix-grid">
            <div class="input-card">
                <h2 style="margin-bottom: 1.5rem; font-weight: 700;"><i class="fa-solid fa-sliders"></i> Metrics Input</h2>
                <div class="input-group">
                    <label>Cohort Selection</label>
                    <select id="cohortSelect" class="styled-select" onchange="loadCohortInputs()">
                        <option value="">-- INITIALIZE --</option>
                        <option value="I ECE A">I ECE A</option>
                        <option value="I ECE B / EEE">I ECE B / EEE</option>
                        <option value="I ECE DS">I ECE DS</option>
                        <option value="I Biotech B / Biomed">I Biotech B / Biomed</option>
                        <option value="II BME">II BME</option>
                        <option value="II ECE DS A">II ECE DS A</option>
                        <option value="II ECE DS B">II ECE DS B</option>
                        <option value="III BME">III BME</option>
                        <option value="III ECE A">III ECE A</option>
                        <option value="III ECE B">III ECE B</option>
                        <option value="III ECE DS">III ECE DS</option>
                        <option value="IV ECE A">IV ECE A</option>
                        <option value="IV ECE B">IV ECE B</option>
                    </select>
                </div>
                <div id="subjectInputs" style="max-height: 250px; overflow-y: auto; margin-bottom: 1.5rem; padding-right:5px;">
                    <p style="color: var(--text-muted); font-size: 0.9rem;">Select a cohort to enter attendance %.</p>
                </div>
                <div style="border-top: 1px solid #e5e7eb; padding-top: 1.5rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.5rem;"><i class="fa-solid fa-flask"></i> Leave Simulator</label>
                    <div style="display: flex; gap: 1rem;">
                        <input type="number" id="leaveDays" class="styled-input" style="margin-bottom:0;" placeholder="Days off" value="0" min="0">
                        <select id="leaveType" class="styled-select" style="margin-bottom:0;">
                            <option value="sick">Sick / Absent</option>
                            <option value="od">Official Duty (OD)</option>
                        </select>
                    </div>
                </div>
                <button class="btn-execute" onclick="executeAnalysis()"><i class="fa-solid fa-bolt"></i> Execute Analysis</button>
            </div>

            <div class="results-card">
                <div class="health-banner">
                    <div>
                        <h2 style="font-weight: 700; margin-bottom: 0.2rem;"><i class="fa-solid fa-heart-pulse"></i> System Health</h2>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Aggregated structural integrity.</p>
                    </div>
                    <div class="health-circle" id="healthCircle" style="background: #e5e7eb; color: #9ca3af;">0%</div>
                </div>
                <div id="resultsGrid" class="result-items">
                    <div style="text-align: center; color: var(--text-muted); width: 100%; padding: 2rem;">
                        Awaiting Calibration. Execute analysis to map limits.
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- SQUAD MODAL -->
<div class="modal-overlay" id="roomModal">
    <div class="modal">
        <span class="close-modal" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></span>
        <h2 id="modalRoomTitle" style="margin-bottom: 0.2rem; font-size: 2rem;">Room</h2>
        <p id="modalRoomType" style="color: var(--text-muted); margin-bottom: 1.5rem;"></p>
        <div class="timer-circle">
            <div id="countdownTimer" class="timer-val">00:00</div>
            <div style="font-size: 0.8rem; font-weight: 700; color: #666;">Mins Left</div>
        </div>
        <p id="timerStatus" style="font-weight: 600; font-size: 1.1rem; color: #333; margin-bottom:1rem;">Free until next period</p>
        <input type="text" id="whatsappPhone" class="styled-input" style="margin-bottom:0;" placeholder="Friend's Phone (e.g. 919876543210)">
        <button class="squad-btn" onclick="callTheSquad()"><i class="fa-brands fa-whatsapp"></i> Call the Squad</button>
    </div>
</div>

<!-- CHATBOT UI -->
<button class="chat-btn" onclick="toggleChat()"><i class="fa-solid fa-comment-dots"></i></button>
<div class="chat-window" id="chatWindow">
    <div class="chat-header"><i class="fa-solid fa-robot"></i> Attendance Advisor</div>
    <div class="chat-body" id="chatBody">
        <div class="chat-msg msg-bot">Terminal active. Ask me about your attendance projections. (e.g., "If I take a 3-day sick leave, will my Chemistry attendance drop below 75%?")</div>
    </div>
    <div class="chat-input-area">
        <input type="text" id="chatInput" class="styled-input" style="margin-bottom:0; padding:0.6rem;" placeholder="Ask about leave impact..." onkeypress="if(event.key === 'Enter') sendChatMessage()">
        <button class="search-btn" style="position: relative; right: 0; transform: none; width: 45px; height: 45px;" onclick="sendChatMessage()"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
</div>

<script>
// --- UI GLOBALS ---
function switchTab(tabId, btn) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
    if(tabId === 'map-view') render3DMap();
}

// --- 3D MAP GENERATION (7 FLOORS) ---
const roomDatabase = [];
for (let f = 1; f <= 7; f++) {
    // Top (21-27), Right (01-05), Bottom (06-11), Left (12-16)
    for(let r=21; r<=27; r++) roomDatabase.push(createRoom(f, r, false, 'top'));
    for(let r=1; r<=5; r++) roomDatabase.push(createRoom(f, r, false, 'right'));
    for(let r=6; r<=11; r++) roomDatabase.push(createRoom(f, r, false, 'bottom'));
    let hasLabs = (f === 3 || f === 6); // Labs strictly on 3rd & 6th floors
    for(let r=12; r<=16; r++) roomDatabase.push(createRoom(f, r, hasLabs, 'left'));
}

function createRoom(floor, num, isLab, wall) {
    let d = new Date(); d.setMinutes(d.getMinutes() + Math.floor(Math.random()*120)+15);
    return { 
        id: (isLab?'LAB-':'') + `${floor}${num<10?'0'+num:num}`, 
        floor: floor, isLab: isLab, ac: Math.random()>0.4, 
        wallPosition: wall, statusNow: Math.random()>0.3?'free':'occupied', nextClassTime: d 
    };
}

function render3DMap() {
    const floor = parseInt(document.getElementById('floorSelect').value);
    const container = document.getElementById('floorPlanArea');
    container.innerHTML = ''; 
    
    roomDatabase.filter(r => r.floor === floor).forEach(room => {
        const el = document.createElement('div');
        el.className = `room3d ${room.statusNow} ${room.isLab ? 'lab' : ''}`;
        let rNum = parseInt(room.id.replace('LAB-', '').substring(1));
        el.innerText = room.id.replace('LAB-', '');
        
        // Exact Isometric Hollow positioning based on sketch
        if(room.wallPosition === 'top') { el.style.top='0px'; el.style.left=`${30+((rNum-21)*85)}px`; }
        else if(room.wallPosition === 'right') { el.style.right='0px'; el.style.top=`${60+((rNum-1)*75)}px`; }
        else if(room.wallPosition === 'bottom') { el.style.bottom='0px'; el.style.right=`${30+((11-rNum)*100)}px`; }
        else if(room.wallPosition === 'left') { el.style.left='0px'; el.style.bottom=`${60+((rNum-12)*75)}px`; }
        
        if(room.statusNow === 'free') el.onclick = () => openModal(room);
        container.appendChild(el);
    });
}
window.onload = () => { render3DMap(); }

// --- AI FINDER ---
function processAIQuery() {
    const q = document.getElementById('aiInput').value.toLowerCase();
    const res = document.getElementById('aiResults'); res.innerHTML = '';
    if(!q) return;
    
    let floor = q.match(/([1-7])/); floor = floor ? parseInt(floor[1]) : null;
    let filtered = roomDatabase.filter(r => r.statusNow === 'free');
    if(q.includes('ac') || q.includes('air')) filtered = filtered.filter(r=>r.ac);
    if(q.includes('lab')) filtered = filtered.filter(r=>r.isLab);
    if(floor) filtered = filtered.filter(r=>r.floor===floor);
    
    if(!filtered.length) { res.innerHTML = '<p style="grid-column:1/-1;text-align:center;">No matches found. Try another search.</p>'; return; }
    
    filtered.slice(0,6).forEach(room => {
        res.innerHTML += `
            <div class="room-card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                    <span style="font-size:1.4rem; font-weight:700;">${room.id}</span>
                    <div>${room.ac?'<span class="badge ac">AC</span>':''}${room.isLab?'<span class="badge lab">LAB</span>':''}<span class="badge free">FREE</span></div>
                </div>
                <p style="color:var(--text-muted); font-size:0.9rem;">Floor ${room.floor}</p>
                <button class="squad-btn" style="padding:0.6rem; margin-top:1rem;" onclick='openModal(${JSON.stringify(room)})'><i class="fa-solid fa-location-arrow"></i> Claim Room</button>
            </div>
        `;
    });
}

// --- MODAL & SQUAD ---
let activeRoom = null; let timerInterval = null; let roomExpiryDate = null;
function openModal(room) {
    activeRoom = room; roomExpiryDate = new Date(room.nextClassTime); 
    document.getElementById('modalRoomTitle').innerText = room.id;
    document.getElementById('modalRoomType').innerText = `${room.ac?'AC ':''}${room.isLab?'Lab':'Classroom'} • Floor ${room.floor}`;
